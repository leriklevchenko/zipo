                "exec": [
	                  "pm.test('License renewed and ticket returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.ticket).to.be.an('object');",
                  "  pm.expect(json.signature).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
