    {
      "name": "License",
      "item": [
        {
          "name": "License - Create",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
	                  "pm.test('License created', function () {",
	                  "  pm.response.to.have.status(201);",
	                  "  var json = pm.response.json();",
	                  "  pm.expect(json.id).to.be.a('string').and.not.empty;",
	                  "  pm.expect(json.code).to.be.a('string').and.not.empty;",
	                  "  pm.expect(json.ownerId).to.eql(Number(pm.collectionVariables.get('userId')));",
	                  "  pm.expect(json.productId).to.eql(Number(pm.collectionVariables.get('productId')));",
	                  "});",
	                  "",
	                  "var json = pm.response.json();",
	                  "if (json.id) {",
	                  "  pm.collectionVariables.set('licenseId', json.id);",
	                  "}",
	                  "if (json.code) {",
	                  "  pm.collectionVariables.set('licenseCode', json.code);",
	                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
	              {
	                "key": "Authorization",
	                "value": "Bearer {{admin_access_token}}"
	              }
            ],
            "body": {
              "mode": "raw",
	              "raw": "{\n  \"productId\": {{productId}},\n  \"typeId\": {{licenseTypeId}},\n  \"ownerId\": {{userId}},\n  \"deviceCount\": {{deviceCount}},\n  \"description\": \"Postman license\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
	              "raw": "{{base_url}}/api/admin/licenses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
	                "admin",
	                "licenses"
              ]
            }
          }
        },
        {
          "name": "License - Activate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('License activated and ticket returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.ticket).to.be.an('object');",
                  "  pm.expect(json.signature).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.ticket.userId).to.eql(Number(pm.collectionVariables.get('userId')));",
	                  "  pm.expect(json.ticket.licenseCode).to.eql(pm.collectionVariables.get('licenseCode'));",
	                  "  pm.expect(json.ticket.deviceId).to.eql(pm.collectionVariables.get('deviceMac'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
	              "raw": "{\n  \"activationKey\": \"{{licenseCode}}\",\n  \"deviceMac\": \"{{deviceMac}}\",\n  \"deviceName\": \"{{deviceId}}\",\n  \"ticketLifetimeSeconds\": {{ticketLifetimeSeconds}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
	              "raw": "{{base_url}}/api/user/licenses/activate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
	                "licenses",
	                "activate"
              ]
            }
          }
        },
