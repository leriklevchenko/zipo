{
  "info": {
    "name": "ZIoVPO Server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://localhost:8080"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "licenseId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"user@example.com\",\n  \"password\": \"yourpassword\",\n  \"deviceId\": \"postman\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Auth - Refresh",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/refresh",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "refresh"
          ]
        }
      }
    },
    {
      "name": "Public - Ping",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/public/ping",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "public",
            "ping"
          ]
        }
      }
    },
    {
      "name": "WhoAmI",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/whoami",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "whoami"
          ]
        }
      }
    },
    {
      "name": "License - Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"deviceId\": \"device-123\",\n  \"validityDays\": 30\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/user/license/create",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "user",
            "license",
            "create"
          ]
        }
      }
    },
    {
      "name": "License - Activate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"licenseId\": \"{{licenseId}}\",\n  \"ticketLifetimeSeconds\": 900\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/user/license/activate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "user",
            "license",
            "activate"
          ]
        }
      }
    },
    {
      "name": "License - Check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/user/license/check?licenseId={{licenseId}}&ticketLifetimeSeconds=900",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "user",
            "license",
            "check"],
          "query": [
            {
              "key": "licenseId",
              "value": "{{licenseId}}"
            },
            {
              "key": "ticketLifetimeSeconds",
              "value": "900"
            }
          ]
        }
      }
    },
    {
      "name": "License - Extend",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"licenseId\": \"{{licenseId}}\",\n  \"additionalDays\": 30,\n  \"ticketLifetimeSeconds\": 900\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/user/license/extend",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "user",
            "license",
            "extend"
          ]
        }
      }
    }
  ]
}
