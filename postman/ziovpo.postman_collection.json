              }
            ],
            "url": {
	              "raw": "{{base_url}}/api/user/licenses/check?deviceMac={{deviceMac}}&productId={{productId}}&ticketLifetimeSeconds={{ticketLifetimeSeconds}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
