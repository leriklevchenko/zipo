    {
      "name": "Antivirus Signatures",
      "item": [
        {
          "name": "Signature - Create",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('signatureSince', new Date(Date.now() - 60000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signature created and signed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.status).to.eql('ACTIVE');",
                  "  pm.expect(json.digitalSignature).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('signatureId', json.id);",
                  "}",
                  "if (json.digitalSignature) {",
                  "  pm.collectionVariables.set('signatureDigitalSignature', json.digitalSignature);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{signatureName}}\",\n  \"version\": \"{{signatureVersion}}\",\n  \"pattern\": \"{{signaturePattern}}\",\n  \"description\": \"{{signatureDescription}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/signatures",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "signatures"
              ]
            }
          }
        },
        {
          "name": "Signature - Get By Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signature can be loaded by id', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.id).to.eql(pm.collectionVariables.get('signatureId'));",
                  "  pm.expect(json.digitalSignature).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/signatures/{{signatureId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "signatures",
                "{{signatureId}}"
              ]
            }
          }
        },
        {
          "name": "Signature - Update",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signature updated and signature recalculated', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.id).to.eql(pm.collectionVariables.get('signatureId'));",
                  "  pm.expect(json.version).to.eql('1.0.1');",
                  "  pm.expect(json.digitalSignature).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.digitalSignature).to.not.eql(pm.collectionVariables.get('signatureDigitalSignature'));",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json.digitalSignature) {",
                  "  pm.collectionVariables.set('signatureDigitalSignature', json.digitalSignature);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{signatureName}}\",\n  \"version\": \"1.0.1\",\n  \"pattern\": \"{{signaturePattern}}-UPDATED\",\n  \"description\": \"Updated from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/signatures/{{signatureId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "signatures",
                "{{signatureId}}"
              ]
            }
          }
        },
        {
          "name": "Signature - Delete Logical",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signature deleted logically and signature recalculated', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.id).to.eql(pm.collectionVariables.get('signatureId'));",
                  "  pm.expect(json.status).to.eql('DELETED');",
                  "  pm.expect(json.digitalSignature).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.digitalSignature).to.not.eql(pm.collectionVariables.get('signatureDigitalSignature'));",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json.digitalSignature) {",
                  "  pm.collectionVariables.set('signatureDigitalSignature', json.digitalSignature);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/signatures/{{signatureId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "signatures",
                "{{signatureId}}"
              ]
            }
          }
        },
        {
          "name": "Signature - Full Export",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Full export does not contain DELETED signatures', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json).to.be.an('array');",
                  "  pm.expect(json.some(function (item) { return item.status === 'DELETED'; })).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/signatures/full",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "signatures",
                "full"
              ]
            }
          }
        },
        {
          "name": "Signature - Incremental Export",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Incremental export contains records after since, including DELETED', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json).to.be.an('array');",
                  "  pm.expect(json.some(function (item) {",
                  "    return item.id === pm.collectionVariables.get('signatureId') && item.status === 'DELETED';",
